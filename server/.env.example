# Copy to server/.env (gitignored) and fill in before `docker compose up`.

POSTGRES_PASSWORD=
# Password for salamanders_app, the data-only role the API connects as (the
# owner above is for admin work). Generate one: openssl rand -hex 24
# Then create the role once with app-role.sql (README, "Database roles").
APP_DB_PASSWORD=

# The site's real origin, once deployed off GitHub Pages — CORS rejects
# everything else. http://localhost:5173 for local frontend dev against
# this API.
ALLOWED_ORIGIN=http://localhost:5173

# The guild this API serves.
DISCORD_GUILD_ID=1322056087792521269

# The bot's token. Unlike the static site, this server can hold it safely: it
# never ships to a browser.
DISCORD_BOT_TOKEN=

# Member reports. Discord webhook for the leadership channel; pings carry a
# report id and link only. SECRET — anyone holding it can post there.
REPORTS_WEBHOOK_URL=
# Optional overrides; defaults are XVIIILegion (files) and Reclusiarch (reviews).
REPORTER_ROLE_ID=
RECLUSIARCH_ROLE_ID=

# The Legion roster (GET /roster) refreshes from Discord this often, in ms.
# Defaults to 300000 (5 minutes); only the e2e stack shortens it.
# Leave unset for the 5-minute default: a negative or non-finite value stops
# the API starting (createRoster rejects it).
# ROSTER_TTL_MS=300000

# Leave unset for real dev/prod use — defaults to the real Discord API.
# Only the e2e/ stack sets this, pointing it at the local Discord mock.
DISCORD_API_BASE=

# Perk corrections: where the API reads the wiki bake (defaults to main on GitHub).
# BAKE_BASE_URL=https://raw.githubusercontent.com/BigZano/salamanders-site/main/src/data/
# Role overrides (defaults are the live guild's ids):
# TECHMARINE_ROLE_ID=  MECHADENDRITE_ROLE_ID=  FORGE_ROLE_ID=  HIERARCHY_ROLE_ID=

# Deathwatch area (/deathwatch/*). The Discord role ids have no defaults:
# until BOTH are set the area answers 503. The Watch Commander role edits and
# grants access (one id); the Deathwatch roles read. DEATHWATCH_ROLE_ID takes
# one id or several, comma-separated with no spaces (a holder of any one gets
# in); a single bad item turns the whole area off (503), never half of it on.
# Role ids stay out of git.
DEATHWATCH_ROLE_ID=
WATCH_COMMANDER_ROLE_ID=
# Optional: the Deathwatch Command role (one id, a different role from the Watch
# Commander). It counts as Deathwatch Deployment and adds the Watch Command tab.
# Unset or not a single id, nobody holds it and the area is unaffected.
DEATHWATCH_COMMAND_ROLE_ID=
# Optional: the Emissary role (one id), for guests. Like the Legion role, it opens
# the Hall of Relics and Recruitment.
EMISSARY_ROLE_ID=
# Optional: the award roles (one id each). Xenosbane Sigil and Vigilia Mortis open the
# Chronicles by default (Manage > Access can change that); Kill-Marine opens no part.
XENOSBANE_SIGIL_ROLE_ID=
VIGILIA_MORTIS_ROLE_ID=
KILL_MARINE_ROLE_ID=
